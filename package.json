{
  "name": "pos",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo del sistema POS: NestJS + Next.js + Prisma + PostgreSQL",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.16.1"
  },
  "scripts": {
    "dev:api": "pnpm --filter @pos/api dev",
    "dev:web": "pnpm --filter @pos/web dev",
    "build": "pnpm --recursive build",
    "test": "pnpm --recursive test",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
