# PostgreSQL (contenedor db)
POSTGRES_USER=pos
POSTGRES_PASSWORD=pos
POSTGRES_DB=pos

# API (contenedor api). Host `db` según docker-compose.
DATABASE_URL=postgresql://pos:pos@db:5432/pos
PORT=3001

# Autenticación (Fase 2). Obligatorias, mínimo 32 caracteres cada una.
# Los valores de abajo son SOLO de desarrollo: genera otros en producción
# (por ejemplo `openssl rand -base64 48`).
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-0123456789abcdef

# Origen del frontend: CORS con credenciales y validación de `Origin` en
# mutaciones. Admite varios orígenes separados por comas.
WEB_ORIGIN=http://localhost:3000

# Web (contenedor web). URL interna hacia la API.
API_INTERNAL_URL=http://api:3001
